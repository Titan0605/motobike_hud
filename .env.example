# Config real del VMS: public/config/channels.json (se edita desde la UI o a mano).
# Estas variables VITE_* son SOLO fallback compilado por si el JSON no está disponible.
#
# Transporte de Janus:
#   - "ws"   -> WebSocket, puerto típico 8188 (recomendado, no sufre CORS). Por defecto.
#   - "http" -> REST, puerto típico 8088 (se proxyfica por Vite para evitar CORS).
VITE_CAM1_HOST=10.100.0.129
VITE_CAM2_HOST=192.168.0.199
VITE_CAM3_HOST=192.168.0.198
VITE_CAM4_HOST=192.168.0.200

# Opcionales por canal (default: transport=ws, port=8188, path=/janus)
# VITE_CAM1_PORT=8188
# VITE_CAM1_PATH=/janus
# VITE_CAM1_TRANSPORT=ws
# VITE_CAM1_STREAM_ID=99
# VITE_CAM1_NAME=Cámara 1

# Compat legacy (se mapea a CAM1/CAM2 si no defines VITE_CAM1/CAM2)
# VITE_JANUS_SERVER_FRONT_URL=http://192.168.0.197:8088/janus
# VITE_JANUS_SERVER_REAR_URL=http://192.168.0.199:8088/janus
# VITE_STREAM_FRONT_ID=99
# VITE_STREAM_REAR_ID=100

# Reconexión (ms)
VITE_RECONNECT_BASE_MS=1000
VITE_RECONNECT_MAX_MS=10000

# Forzar bitrate de video en el SDP del answer (paridad con feature/websocket_imp)
# VITE_FORCE_SDP_VIDEO_BITRATE=true
# VITE_SDP_VIDEO_BITRATE_KBPS=4000
